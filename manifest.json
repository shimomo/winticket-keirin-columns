{
  "manifest_version": 3,
  "name": "WINTICKET 競輪 出走表 列カスタマイズ（非公式）",
  "version": "0.1.0",
  "description": "ウィンチケット競輪（オートレースは対象外）の出走表で、列の並び替えと表示/非表示を設定できます。非公式の個人開発です。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.winticket.jp/keirin/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
